<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <RootNamespace>Consumer</RootNamespace>
    <AssemblyName>Consumer</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
     <AssemblyTitle>Nehta.VendorLibrary.CDA.Sample</AssemblyTitle>
    <Description>This Library helps generate Agency defined CDA documents</Description>
    <AssemblyConfiguration></AssemblyConfiguration>
    <Company>Australian Digital Health Agency</Company>
    <Product>Nehta.VendorLibrary.CDA.Sample</Product>
    <Copyright>Copyright ©2019</Copyright>
    <ComVisible>false</ComVisible>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">       
    <Reference Include="System.configuration" />         
    <Reference Include="System.Security" />
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />   
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
      <PackageReference Include="Nehta.VendorLibrary.Common" Version="5.0.2" />
  </ItemGroup>
    <ItemGroup>
    <None Include="App.config" />
    <None Include="Attachments\attachment.pdf" CopyToOutputDirectory="PreserveNewest" /> 
    <Content Include="Attachments\logo.png" CopyToOutputDirectory="Always" />  
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CDA.GeneratedCode\CDA.GeneratedCode.csproj" />
    <ProjectReference Include="..\CDA.Generator.Common\CDA.Generator.Common.csproj" />
    <ProjectReference Include="..\CDA.Generator\CDA.Generator.csproj" />
    <ProjectReference Include="..\CDA.Sample\CDA.Sample.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>
