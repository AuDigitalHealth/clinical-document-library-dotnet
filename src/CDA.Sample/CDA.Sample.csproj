<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net472;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Nehta.VendorLibrary.CDA.Sample</RootNamespace>
	</PropertyGroup>
	<PropertyGroup>
		<AssemblyTitle>Nehta.VendorLibrary.CDA.Sample</AssemblyTitle>
		<Description>This Library helps generate Agency defined CDA documents</Description>
		<AssemblyConfiguration></AssemblyConfiguration>
		<Company>Australian Digital Health Agency</Company>
		<Product>Nehta.VendorLibrary.CDA.Sample</Product>
		<Copyright>Copyright ©2026</Copyright>
		<ComVisible>false</ComVisible>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Nehta.VendorLibrary.Common" Version="5.0.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<Reference Include="System.configuration" />
		<Reference Include="System.Core" />
		<Reference Include="System.Drawing" />
		<Reference Include="System.Runtime.Serialization" />
		<Reference Include="System.Security" />
		<Reference Include="System.ServiceModel" />
		<Reference Include="System.Web.Extensions" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="System.Data" />
		<Reference Include="System.Xml" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\CDA.GeneratedCode\CDA.GeneratedCode.csproj" />
		<ProjectReference Include="..\CDA.Generator.Common\CDA.Generator.Common.csproj" />
		<ProjectReference Include="..\CDA.Generator\CDA.Generator.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="Attachments\1ASnippet.txt" CopyToOutputDirectory="Always" />
		<Content Include="Attachments\logo.png" CopyToOutputDirectory="Always" />
		<Content Include="Attachments\x-ray.jpg" CopyToOutputDirectory="Always" />
		<Content Include="CdaExtensionsSample\CdaExtensions.xml" CopyToOutputDirectory="Always">
			<SubType>Designer</SubType>
		</Content>
		<Content Include="CdaExtensionsSample\CdaExtensionsOutput.xml" CopyToOutputDirectory="Always">
			<SubType>Designer</SubType>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<None Include="App.config" />
		<Content Include="Attachments\CDA.xsd" CopyToOutputDirectory="Always">
			<SubType>Designer</SubType>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Attachments\path1234.pdf" CopyToOutputDirectory="Always" />
		<Content Include="Attachments\attachment.pdf" CopyToOutputDirectory="Always" />
		<Content Include="Attachments\PIT.txt" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Attachments\other1234.pdf" CopyToOutputDirectory="Always" />
		<None Include="CdaExtensionsSample\attachmentFileName.pdf" CopyToOutputDirectory="Always" />
		<None Include="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>
</Project>
