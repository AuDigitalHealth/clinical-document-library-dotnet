<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net472;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
	  
  <PropertyGroup>
    <Version>5.0.1.0</Version>
    <Description>This Library helps generate Agency defined CDA documents</Description>
    <Company>Australian Digital Health Agency</Company>
    <Copyright>Copyright ©2026</Copyright>
  </PropertyGroup>

	<PropertyGroup>
		<NoWarn>CS1591, CS8981</NoWarn>
	</PropertyGroup>
</Project>