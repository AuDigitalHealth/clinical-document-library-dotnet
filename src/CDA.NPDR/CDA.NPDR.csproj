<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net472;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<AssemblyTitle>Nehta.VendorLibrary.CDA.NPDR</AssemblyTitle>
		<RootNamespace>CDA.NPDR</RootNamespace>
		<AssemblyName>CDA.NPDR</AssemblyName>
	</PropertyGroup>
	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AssemblyTitle>Nehta.VendorLibrary.CDA.NPDR</AssemblyTitle>
		<Description>This Library helps generate Agency defined CDA documents</Description>
		<AssemblyConfiguration></AssemblyConfiguration>
		<Company>Australian Digital Health Agency</Company>
		<Product>Nehta.VendorLibrary.CDA.NPDR</Product>
		<Copyright>Copyright ©2019</Copyright>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Nehta.VendorLibrary.Common" Version="5.0.0" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<Reference Include="System.configuration" />
		<Reference Include="System.Core" />
		<Reference Include="System.Security" />
		<Reference Include="System.ServiceModel" />
		<Reference Include="System.Web.Extensions" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="System.Data" />
		<Reference Include="System.Xml" />
	</ItemGroup>
	<ItemGroup>
		<None Include="App.config" />
		<Content Include="Attachments\logo.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\CDA.GeneratedCode\CDA.GeneratedCode.csproj" />
		<ProjectReference Include="..\CDA.Generator.Common\CDA.Generator.Common.csproj" />
		<ProjectReference Include="..\CDA.Generator\CDA.Generator.csproj" />
		<ProjectReference Include="..\CDA.Sample\CDA.Sample.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="Properties\" />
	</ItemGroup>
</Project>
