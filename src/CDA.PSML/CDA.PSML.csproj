<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net472;net10.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>CDA.PSML</RootNamespace>
		<AssemblyName>CDA.PSML</AssemblyName>
	</PropertyGroup>
	<PropertyGroup>
		<AssemblyTitle>Nehta.VendorLibrary.CDA.PCML</AssemblyTitle>
		<Description>This Library helps generate Agency defined CDA documents</Description>
		<Company>Australian Digital Health Agency</Company>
		<Product>Nehta.VendorLibrary.CDA.PCML</Product>
		<Copyright>Copyright ©2026</Copyright>
		<ComVisible>false</ComVisible>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Nehta.VendorLibrary.Common" Version="5.0.1" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<Reference Include="System.configuration" />
		<Reference Include="System.Core" />
		<Reference Include="System.Security" />
		<Reference Include="System.ServiceModel" />
		<Reference Include="System.Web.Extensions" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="System.Data" />
		<Reference Include="System.Xml" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\CDA.GeneratedCode\CDA.GeneratedCode.csproj" />
		<ProjectReference Include="..\CDA.Generator.Common\CDA.Generator.Common.csproj" />
		<ProjectReference Include="..\CDA.Generator\CDA.Generator.csproj" />
	</ItemGroup>
	<ItemGroup>
		<None Include="app.config" />
		<None Include="Attachments\attachment.pdf" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Attachments\logo.png" CopyToOutputDirectory="Always" />
	</ItemGroup>
</Project>